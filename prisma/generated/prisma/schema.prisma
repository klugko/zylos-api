generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String             @id @default(uuid())
  name          String
  description   String?
  clientType    ProjectClientType?
  industry      String?            @db.VarChar(100)
  color         String?            @db.VarChar(10)
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?           @db.Decimal(10, 2)
  progress      Float              @default(0.0)
  status        ProjectStatus      @default(NOT_STARTED)
  priority      ProjectPriority    @default(MEDIUM)
  isArchived    Boolean            @default(false)
  aiSuggestions Json? //Suggestions IA
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  // Relations
  owner         User?              @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId       String?
  members       ProjectMember[]
  tasks         Task[]
  checklists    Checklist[]
  columns       TaskColumn[]
  documents     Document[]
  template      ProjectTemplate?   @relation(fields: [templateId], references: [id])
  templateId    String?
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  endDate        DateTime?
  progress       Float        @default(0.0)
  color          String?      @db.VarChar(10)
  estimatedTime  Int?
  // Relations
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  column         TaskColumn?  @relation(fields: [columnId], references: [id])
  columnId       String?
  assignee       User?        @relation(fields: [assignedUserId], references: [id])
  assignedUserId String?

  comments       Comment[]
  checklistItems ChecklistItem[]

  dependencies String[] //TODO : changer cet colonne
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskColumn {
  id        String  @id @default(uuid())
  name      String
  order     Int
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  tasks     Task[]
}

model Checklist {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChecklistItem {
  id        String   @id @default(uuid())
  title     String
  isChecked Boolean  @default(false)
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id])
  projectId String
  user      User        @relation(fields: [userId], references: [id])
  userId    String
}

model Document {
  id           String   @id @default(uuid())
  name         String
  type         String?
  url          String   @db.Text
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String          @id @default(uuid())
  fullname         String          @db.VarChar(255)
  email            String          @unique @db.VarChar(255)
  password         String          @db.VarChar(255)
  role             UserRole        @default(USER)
  isActive         Boolean         @default(true)
  skills           String[]
  availability     Int             @default(0)
  performanceScore Float           @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  // Relations
  projectsOwned    Project[]       @relation("ProjectOwner")
  documents        Document[]
  comments         Comment[]
  Task             Task[]
  ProjectMember    ProjectMember[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectClientType {
  SIMPLE
  CODEUR
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  OWNER
  MEMBER
  OBSERVER
}

enum UserRole {
  USER
  ADMIN
  COLLABORATOR
  MANAGER
}

model ProjectTemplate {
  id          String         @id @default(uuid())
  name        String
  description String?
  projects    Project[]
  tasks       TaskTemplate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TaskTemplate {
  id                String              @id @default(uuid())
  title             String
  description       String?
  order             Int
  projectTemplate   ProjectTemplate     @relation(fields: [projectTemplateId], references: [id])
  projectTemplateId String
  checklists        ChecklistTemplate[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ChecklistTemplate {
  id             String       @id @default(uuid())
  title          String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id])
  taskTemplateId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
