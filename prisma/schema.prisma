generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMERATIONS
// ======================================================
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectClientType {
  SIMPLE
  CODEUR
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  OWNER
  MEMBER
  ADMIN
  VIEWER
  GUEST
}

enum UserRole {
  USER
  ADMIN
  COLLABORATOR
  MANAGER
  PARTNER
}

enum ChecklistStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ChecklistPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommentTargetType {
  PROJECT
  TASK
  CHECKLIST
}

enum RequestStatus {
  OPEN
  ASSIGNED
  CONVERTED_TO_TASK
  CLOSED
}

enum DocumentTag {
  CC
  CTC
  CTF
  OC
  PVR
  DV
  FA
  DJ
  DC
  NI
  BDG
  RAP
  PLN
  CRR
  SPF
  SPT
  ETU
  CHP
  AVC
  MNT
  RCX
}


// ======================================================
// MODELS
// ======================================================

model Project {
  id                  String             @id @default(uuid())
  name                String
  description         String?
  clientType          ProjectClientType?
  industry            String?            @db.VarChar(100)
  color               String?            @db.VarChar(10)
  startDate           DateTime?
  endDate             DateTime?
  budget              Decimal?           @db.Decimal(10, 2)
  progress            Float              @default(0.0)
  status              ProjectStatus      @default(NOT_STARTED)
  priority            ProjectPriority    @default(MEDIUM)
  isArchived          Boolean            @default(false)
  aiSuggestions       Json?
  aiGenerateStructure Boolean            @default(false)
  meetingUrl String?  @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner      User?            @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId    String?
  members    ProjectMember[]
  tasks      Task[]
  checklists Checklist[]
  columns    TaskColumn[]
  documents  Document[]
  template   ProjectTemplate? @relation(fields: [templateId], references: [id])
  templateId String?

  accesses        ProjectAccess[]
  partnerRequests PartnerRequest[]
  activityLogs    PartnerActivityLog[]
  roleAssignments UserRoleAssignment[]
  chatMessages ProjectChatMessage[]
  taskBlockers TaskBlocker[]
  invitations Invitation[]
  surveys      Survey[]
  simulations  ProjectSimulation[]
  customStatuses CustomStatus[]
  statusDurations StatusDuration[]
  statusAlerts StatusAlert[]
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  startDate     DateTime?
  endDate       DateTime?
  progress      Float        @default(0.0)
  color         String?      @db.VarChar(10)
  estimatedTime Int?
  isCompleted  Boolean      @default(false)

  project        Project?    @relation(fields: [projectId], references: [id])
  projectId      String?
  column         TaskColumn? @relation(fields: [columnId], references: [id])
  columnId       String?
  assignee       User?       @relation(fields: [assignedUserId], references: [id])
  assignedUserId String?

  comments       Comment[]
  checklistItems ChecklistItem[]
  checklists     Checklist[]
  blockers       TaskBlocker[]
  surveys        Survey[]
  activityLogs   PartnerActivityLog[]
  statusDurations StatusDuration[]
  statusAlerts   StatusAlert[]

  dependencies String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskColumn {
  id        String  @id @default(uuid())
  name      String
  order     Int
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  tasks     Task[]
}

model Checklist {
  id          String  @id @default(uuid())
  title       String
  status      ChecklistStatus   @default(TODO)     
  priority    ChecklistPriority @default(MEDIUM)   

  task        Task    @relation(fields: [taskId], references: [id])
  taskId      String
  project     Project @relation(fields: [projectId], references: [id])
  projectId   String

  assignedTo     User?   @relation(fields: [assignedUserId], references: [id])
  assignedUserId String?

  items       ChecklistItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())
}

model ChecklistItem {
  id        String  @id @default(uuid())
  title     String
  isChecked Boolean @default(false)

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String

  checklist   Checklist? @relation(fields: [checklistId], references: [id])
  checklistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id])
  projectId String
  user      User        @relation(fields: [userId], references: [id])
  userId    String
}

model Document {
  id                 String   @id @default(uuid())
  name               String
  type               String?
  url                String   @db.Text
  uploadedBy         User?    @relation(fields: [uploadedById], references: [id])
  uploadedById       String?
  project            Project  @relation(fields: [projectId], references: [id])
  projectId          String
  tags               DocumentTag[] @default([])
  metadata           Json?
  validationRequired Boolean  @default(false)
  uploadedAt         DateTime @default(now())
  updatedAt          DateTime @default(now())
  versions           DocumentVersion[]
  comments           DocumentComment[]
  notificationRules  DocumentNotificationRule[]
  signatures         DocumentSignature[]

  accesses     DocumentAccess[]
  activityLogs PartnerActivityLog[]
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  url        String   @db.Text
  versionAt  DateTime @default(now())
  name       String
  type       String?
  size       Int
  mimetype   String
}

model DocumentComment {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  zone       String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DocumentNotificationRule {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  trigger     String   // remain as string
  frequency   String   // remain as string
  channel     String   // remain as string
  targetEmail String?
  targetUrl   String?
  createdAt   DateTime @default(now())
}

model DocumentSignature {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status       String   // remain as string
  signatureUrl String?
  requestedAt  DateTime @default(now())
  signedAt     DateTime?
}

model Comment {
  id         String            @id @default(uuid())
  content    String
  targetType CommentTargetType
  targetId   String

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  Task      Task?    @relation(fields: [taskId], references: [id])
  taskId    String?
}


model User {
  id               String   @id @default(uuid())
  fullname         String   @db.VarChar(255)
  email            String   @unique @db.VarChar(255)
  password         String   @db.VarChar(255)
  role             UserRole @default(USER)
  isActive         Boolean  @default(true)
  skills           String[]
  availability     Int      @default(0)
  performanceScore Float    @default(0.0)
  googleId         String?  @unique
  avatarUrl        String?  @db.Text
  phone            String?  @db.VarChar(20)
  poste            String?  @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  twoFASecret      String?
  isTwoFAEnabled   Boolean  @default(false)
  passwordChangedAt DateTime?

  external        Boolean @default(false)
  partnerType     String?
  activationToken String?

  emailVerified         Boolean   @default(false)
  emailVerificationToken String?  @unique
  emailVerificationExpiry DateTime?

  refreshTokens   RefreshToken[]

  projectsOwned   Project[]               @relation("ProjectOwner")
  documents       Document[]
  comments        Comment[]
  Task            Task[]
  ProjectMember   ProjectMember[]
  projectAccess   ProjectAccess[]
  documentAccess  DocumentAccess[]
  partnerRequests PartnerRequest[]
  partnerMessages PartnerRequestMessage[]
  activityLogs    PartnerActivityLog[]
  roleAssignments UserRoleAssignment[]
  projectChatMessages ProjectChatMessage[]
  blockerSolutions BlockerSolution[]
  checkelists     Checklist[]
  surveys         Survey[]
  votes           Vote[]
  simulations     ProjectSimulation[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProjectTemplate {
  id          String         @id @default(uuid())
  name        String
  description String?
  projects    Project[]
  tasks       TaskTemplate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
}

model TaskTemplate {
  id                String              @id @default(uuid())
  title             String
  description       String?
  order             Int
  projectTemplate   ProjectTemplate     @relation(fields: [projectTemplateId], references: [id])
  projectTemplateId String
  checklists        ChecklistTemplate[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
}

model ChecklistTemplate {
  id             String       @id @default(uuid())
  title          String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id])
  taskTemplateId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model ReminderNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String
  taskId    String
  createdAt DateTime @default(now())
}


model Role {
  id              String   @id @default(uuid())
  name            String
  description     String?
  canRead         Boolean  @default(false)
  canWrite        Boolean  @default(false)
  canComment      Boolean  @default(false)
  canValidate     Boolean  @default(false)
  canDelete       Boolean  @default(false)
  canUseVisio     Boolean  @default(false)
  canUseDashboard Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments UserRoleAssignment[]
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
}

model ProjectAccess {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  canRead     Boolean  @default(true)
  canWrite    Boolean  @default(false)
  canComment  Boolean  @default(false)
  canValidate Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  canRead    Boolean  @default(true)
  canWrite   Boolean  @default(false)
  canComment Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

enum ActivityType {
  TASK
  PROJECT
  DOCUMENT
  USER
  SURVEY
  COMMENT
  CHAT
  NOTIFICATION
  SYSTEM
}

enum ActivityAction {
  // Task actions
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_COMMENTED
  
  // Project actions
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_STARTED
  PROJECT_COMPLETED
  PROJECT_PAUSED
  PROJECT_ARCHIVED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_ACCESS_CHANGED
  
  // Document actions
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SHARED
  DOCUMENT_ACCESS_CHANGED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_SIGNED
  DOCUMENT_COMMENTED
  
  // User actions
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_REGISTERED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ROLE_CHANGED
  
  // Survey actions
  SURVEY_CREATED
  SURVEY_UPDATED
  SURVEY_DELETED
  SURVEY_ACTIVATED
  SURVEY_CLOSED
  SURVEY_VOTED
  SURVEY_RESULTS_VIEWED
  
  // Comment actions
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  COMMENT_LIKED
  COMMENT_DISLIKED
  
  // Chat actions
  CHAT_MESSAGE_SENT
  CHAT_MESSAGE_EDITED
  CHAT_MESSAGE_DELETED
  CHAT_ROOM_CREATED
  CHAT_ROOM_JOINED
  CHAT_ROOM_LEFT
  
  // Notification actions
  NOTIFICATION_SENT
  NOTIFICATION_READ
  NOTIFICATION_DELETED
  
  // System actions
  SYSTEM_BACKUP
  SYSTEM_MAINTENANCE
  SYSTEM_ERROR
  SYSTEM_WARNING
}

model PartnerActivityLog {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id])
  documentId  String?
  document    Document?     @relation(fields: [documentId], references: [id])
  surveyId    String?
  survey      Survey?       @relation(fields: [surveyId], references: [id])
  
  // Activity categorization
  type        ActivityType
  action      ActivityAction
  title       String        // Human-readable title
  description String?       // Detailed description
  
  // Metadata
  metadata    Json?         // Additional data (old values, new values, etc.)
  ipAddress   String?       // IP address of the user
  userAgent   String?       // User agent string
  
  // Timestamps
  createdAt   DateTime      @default(now())
  
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, action])
  @@index([createdAt])
  @@map("activity_logs")
}

model PartnerRequest {
  id         String                  @id @default(uuid())
  projectId  String
  project    Project                 @relation(fields: [projectId], references: [id])
  userId     String
  user       User                    @relation(fields: [userId], references: [id])
  subject    String
  message    String
  attachment String?
  status     RequestStatus           @default(OPEN)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  messages   PartnerRequestMessage[]
}

model PartnerRequestMessage {
  id        String         @id @default(uuid())
  requestId String
  request   PartnerRequest @relation(fields: [requestId], references: [id])
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime       @default(now())
}

model ProjectChatMessage {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}



model TaskBlocker {
  id           String         @id @default(uuid())
  task         Task           @relation(fields: [taskId], references: [id])
  taskId       String
  project      Project        @relation(fields: [projectId], references: [id])
  projectId    String
  blockerType  BlockerType
  severity     BlockerSeverity @default(MEDIUM)
  description  String?
  aiAnalysis   Json?
  isResolved   Boolean        @default(false)
  detectedAt   DateTime       @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  solutions    BlockerSolution[]
}

model BlockerSolution {
  id             String          @id @default(uuid())
  blocker        TaskBlocker     @relation(fields: [blockerId], references: [id])
  blockerId      String
  solutionType   String          // REASSIGN, SPLIT…
  description    String?
  aiReasoning    String?
  confidence     Float?
  status         SolutionStatus  @default(SUGGESTED)
  suggestedUser  User?           @relation(fields: [suggestedUserId], references: [id])
  suggestedUserId String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  appliedAt      DateTime?
}


model Invitation {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  token     String   @unique
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  role      UserRole @default(PARTNER)
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("invitation")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String   @db.VarChar(255)
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verification")
}

model Survey {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        SurveyType
  status      SurveyStatus @default(DRAFT)
  voteType    VoteType     @default(SINGLE)
  
  // Liens avec les projets et tâches
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id])
  
  // Configuration
  allowMultipleVotes Boolean @default(false)
  isAnonymous        Boolean @default(false)
  maxVotesPerUser    Int?    // null = illimité
  weightEnabled      Boolean @default(false)
  
  // Dates
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  creator     User         @relation(fields: [creatorId], references: [id])
  creatorId   String
  options     SurveyOption[]
  votes       Vote[]
  activityLogs PartnerActivityLog[]
  
  @@map("surveys")
}

model SurveyOption {
  id          String  @id @default(uuid())
  surveyId    String
  survey      Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text        String
  description String?
  weight      Float?  // Pour les votes pondérés
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  
  // Relations
  votes       Vote[]
  
  @@map("survey_options")
}

model Vote {
  id          String      @id @default(uuid())
  surveyId    String
  survey      Survey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  optionId    String
  option      SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterId     String
  voter       User        @relation(fields: [voterId], references: [id])
  
  // Données du vote
  weight      Float?      // Poids du vote (pour votes pondérés)
  comment     String?     // Commentaire optionnel
  isAnonymous Boolean     @default(false)
  
  createdAt   DateTime    @default(now())
  
  @@unique([surveyId, voterId, optionId]) // Un utilisateur ne peut voter qu'une fois par option
  @@map("votes")
}

model CustomStatus {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @db.VarChar(10)
  order       Int
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  durations   StatusDuration[]
  alerts      StatusAlert[]

  @@map("custom_statuses")
}

model StatusDuration {
  id             String       @id @default(uuid())
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customStatusId String
  customStatus   CustomStatus @relation(fields: [customStatusId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime?
  duration       Int          @default(0) // en millisecondes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("status_durations")
}

model StatusAlert {
  id               String         @id @default(uuid())
  taskId           String
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customStatusId   String
  customStatus     CustomStatus   @relation(fields: [customStatusId], references: [id], onDelete: Cascade)
  type             AlertType
  severity         AlertSeverity
  message          String
  suggestedStatusId String?
  isResolved       Boolean        @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@map("status_alerts")
}


enum BlockerType {
  INACTIVE_TASK
  CIRCULAR_DEPENDENCY
  SKILL_MISMATCH
  WORKLOAD_OVERLOAD
  UNCLEAR_REQUIREMENTS
  DEPENDENCY_BLOCKED
  RESOURCE_UNAVAILABLE
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SolutionStatus {
  SUGGESTED
  APPLIED
  REJECTED
  EXPIRED
}

enum SurveyType {
  MULTIPLE_CHOICE
  YES_NO
  WEIGHTED
  RATING
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum VoteType {
  SINGLE
  MULTIPLE
  WEIGHTED
}

enum SimulationScenario {
  OPTIMAL
  REALISTIC
  DEGRADED
}

model ProjectSimulation {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  scenarios     Json     // Contient les 3 scénarios (optimal, realistic, degraded)
  impactFactors Json     // Contient les facteurs d'impact
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_simulations")
}

enum AlertType {
  DURATION_EXCEEDED
  STATUS_STAGNATION
  AUTO_SUGGESTION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
